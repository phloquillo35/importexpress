# Base de datos (usa Postgres — SQLite no compatible con PrismaPg)
# Local: obtén la URL de Railway → Dashboard → Variables → DATABASE_URL
# Producción (Railway): se inyecta automáticamente
DATABASE_URL="postgresql://postgres:TU_PASSWORD@TU_HOST:5432/TU_DB"

# Autenticación
NEXTAUTH_SECRET="generar con: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# URL pública de producción (usada en emails y scripts; default: https://lopedis-lotenes.up.railway.app)
NEXT_PUBLIC_URL=

# Cron / Tareas programadas
CRON_SECRET="cron-secret-importexpress-2026"

# Email (opcional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Uploads (opcional, default: ./public/uploads) — legacy, ya no se usa para imágenes de producto
UPLOADS_DIR=

# Supabase Storage — acá viven las imágenes de productos y del hero
NEXT_PUBLIC_SUPABASE_URL="https://TU_PROYECTO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key (nunca exponer en el cliente)"
